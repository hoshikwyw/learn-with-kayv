# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined at BUILD time — after changing one, rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser; every table is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — bypasses RLS. Never expose it, never prefix it NEXT_PUBLIC_.
# Used for admin-only work: creating users and blocking accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Branding ────────────────────────────────────────────────────────────────
# All optional. Anything left unset falls back to the defaults in
# `src/config/site.ts`. Set these to rebrand without editing code.

# Public origin. Must match the Google OAuth redirect URL registered in
# Supabase (Authentication → URL Configuration). Include the scheme, no
# trailing slash. In production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Learn with Kayv
NEXT_PUBLIC_SITE_SHORT_NAME=Kayv
NEXT_PUBLIC_SITE_DESCRIPTION=One place for students to track grades and timetables, teachers to manage their classes, and admins to run the school.
NEXT_PUBLIC_SITE_TAGLINE=A private-school platform.
NEXT_PUBLIC_SITE_FOUNDED=2026

# One of: GraduationCap | BookOpen | School | Sparkles | Library | Lightbulb
NEXT_PUBLIC_SITE_ICON=GraduationCap

# ── Contact (shown on the public site) ──────────────────────────────────────
NEXT_PUBLIC_SITE_EMAIL=hello@example.com
NEXT_PUBLIC_SITE_PHONE=
NEXT_PUBLIC_SITE_ADDRESS=

# ── Social links (blank = hidden) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_FACEBOOK=
NEXT_PUBLIC_SITE_INSTAGRAM=
NEXT_PUBLIC_SITE_YOUTUBE=
